*.db
backend/ner_logistics.db

# Node / Frontend
frontend/node_modules/
node_modules/
frontend/dist/
dist/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS specific
.DS_Store
Thumbs.db
*.log
