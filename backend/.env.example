# =============================================================================
# NER Logistics Platform (SIH26002) - Backend Environment Configuration Template
# =============================================================================

# 1. Environment Mode ("development" or "production")
ENVIRONMENT=production
PORT=8000

# 2. Database Connection
# Cloud PostgreSQL (Neon, Supabase, Render Postgres, Railway Postgres):
DATABASE_URL=postgresql+asyncpg://postgres_user:your_secure_password@your-db-host.region.provider.com:5432/ner_logistics_db?ssl=require

# Local SQLite fallback for testing:
# DATABASE_URL=sqlite+aiosqlite:///./ner_logistics.db

# 3. Security & JWT Configuration
# Generate a cryptographically random 32+ char key using: openssl rand -hex 32
SECRET_KEY=your_cryptographically_secure_random_32_character_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 4. Production CORS Allowed Origins (Comma-separated HTTPS URLs)
# Include your Vercel frontend URL, custom domains, and local dev for testing
ALLOWED_ORIGINS=https://ner-logistics.vercel.app,https://your-custom-domain.com,http://localhost:5173

# 5. AI Logistics Assistant Configuration (Optional / Grounded LLM)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
